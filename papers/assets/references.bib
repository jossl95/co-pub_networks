@article{heggebo2019,
  title = {Is {{There Less Labor Market Exclusion}} of {{People With Ill Health}} in ``{{Flexicurity}}'' {{Countries}}? {{Comparative Evidence From Denmark}}, {{Norway}}, the {{Netherlands}}, and {{Belgium}}},
