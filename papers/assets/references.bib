@article{blanchflower2008,
  title = {Is Well-Being {{U-shaped}} over the Life Cycle?},
  author = {Blanchflower, David G. and Oswald, Andrew J.},
  year = 2008,
  month = apr,
  journal = {Social Science \& Medicine},
  volume = {66},
