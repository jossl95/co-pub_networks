  shorttitle = {Do Benefit Hikes Damage Job Finding?},
  author = {Bennmarker, Helge and Carling, Kenneth and Holmlund, Bertil},
  year = 2007,
  journal = {Labour},
  volume = {21},
  number = {1},
  pages = {85--120},
  issn = {1467-9914},
  doi = {10.1111/j.1467-9914.2006.00363.x},
  urldate = {2025-02-02},
  abstract = {Abstract. In 2001 and 2002, Sweden introduced several unemployment insurance reforms. A major innovation in the first reform was the introduction of a two-tiered benefit structure for some unemployed individuals. This system involved supplementary compensation during the first 20 weeks of unemployment. The 2002 reform retained the two-tiered benefit structure but involved also substantial benefit hikes for spells exceeding 20 weeks. This paper examines how these reforms affected transitions from unemployment to employment. We take advantage of the fact that the reforms had quasi-experimental features where the `treatments' differed considerably among unemployed individuals. We find that the reforms had strikingly different effects on job finding among men and women. The two reforms in conjunction are estimated to have increased the expected duration of unemployment among men but to have decreased the duration of unemployment among women. The overall effect on the duration of unemployment is not statistically different from zero. However, the reforms reduced job finding among men who remained unemployed for more than 20 weeks.},
  langid = {english},
  file = {/Users/josslabbekoorn/Zotero/storage/MNGRJSR6/Bennmarker et al. - 2007 - Do Benefit Hikes Damage Job Finding Evidence from Swedish Unemployment Insurance Reforms.pdf;/Users/josslabbekoorn/Zotero/storage/U9XJYUYW/j.1467-9914.2006.00363.html}
}

