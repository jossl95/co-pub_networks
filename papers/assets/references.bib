@article{williams2020,
  title = {A Critical Deconstructed Quantitative Analysis: {{Sexual}} and Gender Minority Stress through an Intersectional Lens},
  shorttitle = {A Critical Deconstructed Quantitative Analysis},
  author = {Williams, Stacey L. and Job, Sarah A. and Todd, Emerson and Braun, Kelsey},
  year = 2020,
