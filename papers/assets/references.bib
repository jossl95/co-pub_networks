@article{bernstrom2018,
  title = {Employability as an Alternative to Job Security},
  author = {Bernstr{\o}m, Vilde Hoff and Drange, Ida and Mamelund, Svenn-Erik},
  year = 2018,
  month = jan,
  journal = {Personnel Review},
  volume = {48},
  number = {1},
