  doi = {10.1002/hfm.20620},
  urldate = {2019-07-31},
  abstract = {Previous studies have indicated positive and negative effects of lean production on employees' perceived work characteristics and job attitudes. The most detrimental consequence of lean production is a decrease in the perceived job autonomy of workshop employees. To reduce these negative consequences, we propose human resource practices for integration with lean production. Drawing on the job characteristics model, we hypothesized that the implementation of lean production combined with human resource practices would enhance perceived job autonomy, job satisfaction, and operational performance. To evaluate our hypotheses, we used an experimental design consisting of a simulation game that mimics a manufacturing company. We implemented lean production combined with human resource practices in this simulated company. The results indicated a significant increase in perceived job autonomy, job satisfaction, and operational performance. Moreover, the results revealed a positive relationship between job satisfaction and operational performance. C 2015 Wiley Periodicals, Inc.},
