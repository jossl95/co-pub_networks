@unpublished{slabbekoornForthcominga,
  title = {The {{Mediating Role}} of {{Resources}} in {{Shaping Intersectional Inequalities}} in {{Benefit Receipt}}},
  author = {Slabbekoorn, Jos and Maas, Ineke and Vrooman, J Cok},
  year = {Forthcoming},
  address = {Utrecht, The Netherlands},
  abstract = {This research delves into the intricate dynamics among gender, age, migration background, and benefit receipt, scrutinizing the mediating influence of diverse resources. Focusing on the interplay of economic resources, highbrow cultural capital, and mental health, we employ Bayesian multilevel structural equation models with a novel integration of Dutch register data and longitudinal survey data. Our findings reveal that disparities in social assistance and unemployment benefit receipt are linked to variations in these resources across intersectional strata, with gender differences partially explained by mental health discrepancies. Additionally, non-additive effects are uncovered, elucidating how certain intersectional groups exhibit disproportional resource accumulation, impacting their likelihood of benefit receipt. This study makes a twofold contribution by empirically testing resource mediation in benefit receipt and offering a nuanced understanding of intersectional inequalities, thereby informing targeted policy interventions to mitigate disparities in benefit receipt.},
  langid = {american}
}

