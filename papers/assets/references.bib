@article{petts2024,
  title = {Does Taking Parental Leave Make You a More Likeable Worker? {{Evidence}} from a Survey Experiment},
  shorttitle = {Does Taking Parental Leave Make You a More Likeable Worker?},
  author = {Petts, Richard J. and Mize, Trenton D. and Kaufman, Gayle},
  year = 2024,
