@article{reasch2014,
  title = {Bayesian Inference: Probit and Linear Probability Models},
  author = {Reasch, Nate Rex},
  year = 2014,
  journal = {University of Utah},
  doi = {10.26076/c2ff-73b9},
  abstract = {The following paper analyzes the benefits of Bayes' theorem in applied econometrics. This is accomplished by demonstrating each step in conducting Bayesian inference. This includes the prior selection, the likelihood function, posterior simulation, and model diagnostics. To provide a concrete example I replicate, by Bayesian inference, the main model of Blau, Brough, and Thomas.(2013) This model is found in their research paper titled, Corporate lobbying, Political Connections, and the Bailout of Banks. The analysis focuses on two different forms of limited dependent variable regressions, the probit and linear probability model. The benefits of Bayesian econometrics were extensive and serve as a testament to Bayesian methodology.},
  langid = {english},
